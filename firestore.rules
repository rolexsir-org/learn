rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check for specific user email (Admin logic)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'connecttomatrix@gmail.com' && request.auth.token.email_verified == true;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'totalStars', 'coins', 'currentStreak']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 64 &&
             data.totalStars is int && data.totalStars >= 0 &&
             data.coins is int && data.coins >= 0 &&
             data.currentStreak is int && data.currentStreak >= 0;
    }

    function isValidWordProgress(data) {
      return data.keys().hasAll(['word', 'accuracy', 'attempts', 'isMastered']) &&
             data.word is string && data.word.size() <= 32 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
             data.attempts is int && data.attempts >= 0 &&
             data.isMastered is bool;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Rule: Signed-in users can view profile stats for the Leaderboard
      allow get, list: if isSignedIn();

      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      
      allow update: if isOwner(userId) && 
                      isValidUserProfile(incoming()) && 
                      incoming().userId == existing().userId && // Immutable ID
                      (
                        // Action: Update Progress Stats and Checkpoint State
                        incoming().diff(existing()).affectedKeys().hasOnly(['totalStars', 'coins', 'currentStreak', 'maxStreak', 'lastLoginDate', 'lastRewardClaimed', 'unlockedCharacters', 'claimedQuests', 'unlockedStickers', 'unlockedAvatars', 'unlockedWorlds', 'completedLessons', 'currentWorldId', 'activeWordIndex', 'activeNavTab', 'soundEnabled', 'timeSpent', 'displayName'])
                      );

      allow delete: if isAdmin(); // Only admins can delete profiles

      // Word Progress subcollection
      match /progress/{wordId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId); // Owner can see their own progress list

        allow create: if isOwner(userId) && isValidWordProgress(incoming()) && isValidId(wordId);
        
        allow update: if isOwner(userId) && 
                        isValidWordProgress(incoming()) && 
                        isValidId(wordId) &&
                        (
                          // Action: Record practice session
                          incoming().diff(existing()).affectedKeys().hasOnly(['accuracy', 'speedMs', 'attempts', 'isMastered', 'lastPracticed'])
                        );
        
        allow delete: if isOwner(userId);
      }
    }
  }
}
